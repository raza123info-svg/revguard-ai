# .env.example
# ==============================================================================
# REVGUARD AI - FRONTEND ENVIRONMENT FILE
# ==============================================================================
#
# IMPORTANT SECURITY WARNING:
# API keys are stored ONLY in backend environment variables / secret manager.
# NEVER expose API keys to the Flutter frontend under any circumstances.
#
# Do NOT put your raw Gemini or NewsAPI keys in this file or any frontend configuration.
#
# The Flutter app will call the secure backend proxy layer (e.g. at localhost or a production URL)
# which injects the keys server-side.
#
# Backend proxy endpoints:
# - POST /api/analyze  -> Proxies to Gemini API (injects GEMINI_API_KEY)
# - GET  /api/news     -> Proxies to NewsAPI (injects NEWSAPI_KEY)
#

# The base URL of the backend proxy server.
# For local development:
# - Web: http://localhost:5000
# - Android Emulator: http://10.0.2.2:5000
# - iOS Simulator: http://localhost:5000
BACKEND_PROXY_URL=http://localhost:5000
